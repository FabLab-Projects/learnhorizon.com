{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "./",
  "entryFile": "src/main",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/schemify-microservice-nestjs/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/schemify-microservice-nestjs",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "src/main",
      "sourceRoot": "./",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
        "assets": ["libs/proto/src/services/**/*.proto"],
        "watchAssets": true
      }
    },
    "archivos": {
      "type": "application",
      "root": "apps/archivos",
      "entryFile": "src/main",
      "sourceRoot": "./",
      "compilerOptions": {
        "tsConfigPath": "apps/archivos/tsconfig.app.json",
        "assets": ["libs/proto/src/services/**/*.proto"],
        "watchAssets": true
      }
    },
    "articulos": {
      "type": "application",
      "root": "apps/articulos",
      "entryFile": "src/main",
      "sourceRoot": "./",
      "compilerOptions": {
        "tsConfigPath": "apps/articulos/tsconfig.app.json",
        "assets": ["libs/proto/src/services/**/*.proto"],
        "watchAssets": true
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "src/main",
      "sourceRoot": "./",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json",
        "assets": ["libs/proto/src/services/**/*.proto"],
        "watchAssets": true
      }
    },
    "escenas": {
      "type": "application",
      "root": "apps/escenas",
      "entryFile": "src/main",
      "sourceRoot": "./",
      "compilerOptions": {
        "tsConfigPath": "apps/escenas/tsconfig.app.json",
        "assets": ["libs/proto/src/services/**/*.proto"],
        "watchAssets": true
      }
    },
    "usuarios": {
      "type": "application",
      "root": "apps/usuarios",
      "entryFile": "src/main",
      "sourceRoot": "./",
      "compilerOptions": {
        "tsConfigPath": "apps/usuarios/tsconfig.app.json",
        "assets": ["libs/proto/src/services/**/*.proto"],
        "watchAssets": true
      }
    },
    "proto": {
      "type": "library",
      "root": "libs/proto",
      "entryFile": "index",
      "sourceRoot": "libs/proto/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
        "assets": ["libs/proto/src/services/**/*.proto"],
        "watchAssets": true
      }
    }
  }
}
